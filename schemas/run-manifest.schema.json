{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/latent-reasoning/schemas/run-manifest.schema.json",
  "title": "Latent Reasoning Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "operation",
    "backbone",
    "reasoning_substrate",
    "workload",
    "execution",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "operation": {
      "enum": [
        "train",
        "evaluate",
        "probe"
      ]
    },
    "comparison_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "backbone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "exact_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "foundry_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reasoning_substrate": {
      "$ref": "./reasoning-substrate.schema.json"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "task",
        "split"
      ],
      "properties": {
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "instance_manifest_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "actor_profile_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compute_match": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_run_id": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reference_run_id",
        "basis"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "exact_revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "exact_revision": {
          "type": "string",
          "minLength": 7
        }
      }
    }
  }
}
