{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/SemperSupra/latent-reasoning/schemas/substrate-observation.schema.json",
  "title":"Execution Substrate Observation",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","platform","resources","docker","nvidia"],
  "properties":{
    "schema_version":{"const":1},
    "platform":{
      "type":"object","additionalProperties":false,
      "required":["system","release","machine","python_version"],
      "properties":{
        "system":{"type":"string"},
        "release":{"type":"string"},
        "machine":{"type":"string"},
        "python_version":{"type":"string"}
      }
    },
    "resources":{
      "type":"object","additionalProperties":false,
      "required":["logical_cpus","memory_total_bytes","disk_free_bytes"],
      "properties":{
        "logical_cpus":{"type":"integer","minimum":1},
        "memory_total_bytes":{"type":["integer","null"],"minimum":0},
        "disk_free_bytes":{"type":"integer","minimum":0}
      }
    },
    "docker":{
      "type":"object","additionalProperties":false,
      "required":["available","server_version","runtimes"],
      "properties":{
        "available":{"type":"boolean"},
        "server_version":{"type":["string","null"]},
        "runtimes":{"type":"array","items":{"type":"string"}}
      }
    },
    "nvidia":{
      "type":"object","additionalProperties":false,
      "required":["nvidia_smi_available","gpus","container_runtime_declared"],
      "properties":{
        "nvidia_smi_available":{"type":"boolean"},
        "container_runtime_declared":{"type":"boolean"},
        "gpus":{
          "type":"array",
          "items":{
            "type":"object","additionalProperties":false,
            "required":["name","memory_total_mib","driver_version"],
            "properties":{
              "name":{"type":"string"},
              "memory_total_mib":{"type":"integer","minimum":0},
              "driver_version":{"type":"string"}
            }
          }
        }
      }
    }
  }
}
