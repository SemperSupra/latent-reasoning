{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/latent-reasoning/schemas/benchmark-source-registry.schema.json",
  "title": "Benchmark Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "repository", "exact_revision", "license",
          "lineage", "integration", "holdout_policy"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "exact_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "status", "identifiers", "mixed_license"],
            "properties": {
              "class": {"enum": ["A", "B", "C", "D", "E"]},
              "status": {"enum": ["permissive", "custom-permissive", "mixed", "copyleft", "unresolved"]},
              "identifiers": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "mixed_license": {"type": "boolean"},
              "notes": {"type": "string"}
            }
          },
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maintainer_class", "methodology_role"],
            "properties": {
              "maintainer_class": {
                "enum": ["official-research-org", "academic-authors", "independent-researchers", "community"]
              },
              "methodology_role": {"type": "string", "minLength": 1},
              "venue_or_status": {"type": ["string", "null"]}
            }
          },
          "integration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "posture", "vendoring_allowed", "module_audit_required",
              "retain_upstream_notices"
            ],
            "properties": {
              "posture": {
                "enum": [
                  "direct-dependency",
                  "pinned-external",
                  "selective-module",
                  "methodology-only"
                ]
              },
              "vendoring_allowed": {"type": "boolean"},
              "module_audit_required": {"type": "boolean"},
              "retain_upstream_notices": {"type": "boolean"},
              "notes": {"type": "string"}
            }
          },
          "holdout_policy": {
            "enum": [
              "public-fixtures-only",
              "private-seeds-and-instances",
              "upstream-splits-plus-private-extensions"
            ]
          }
        }
      }
    }
  }
}
